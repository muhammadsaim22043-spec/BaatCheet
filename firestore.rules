rules_version = '2';

// Data model (see lib/features/*/data/datasources/*_remote_data_source.dart):
//   users/{uid}         profile, doc ID == Firebase Auth UID
//   chats/{chatId}      chatId == 'chat_' + both UIDs sorted and joined by '_'
//   messages/{msgId}    flat collection, queried by chatId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Firebase UIDs never contain '_', so splitting the chat ID yields
    // ['chat', uidA, uidB].
    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in chatId.split('_');
    }

    match /users/{userId} {
      // Any signed-in user can look up profiles (needed for "new chat by phone number")
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      // Works with the `participantIds arrayContains uid` list query
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update: if isChatMember(chatId)
        && request.resource.data.id == chatId
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;
    }

    match /messages/{messageId} {
      // The chatId equality filter in watchMessages lets the rules engine prove membership
      allow read: if isChatMember(resource.data.chatId);
      allow create: if isChatMember(request.resource.data.chatId)
        && request.resource.data.id == messageId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      // Only the receiver may update, and only to flip the read receipt
      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }
  }
}
